# Wazuh Indexer/OpenSearch: alert and telemetry retrieval
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=change-me
WAZUH_ALERT_INDEX=wazuh-alerts-*
# Optional raw Sysmon/Windows telemetry index. Required to retrieve ordinary
# parent processes that did not themselves generate a Wazuh alert.
# WAZUH_TELEMETRY_INDEX=wazuh-archives-*
WAZUH_VERIFY_TLS=true

# Optional Wazuh manager API: agent inventory / later response validation
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=change-me

# Model selection. Only configure the provider you choose.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=180
# Local Ollama guardrails: bounded context and output keep laptop assessments responsive.
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_TOKENS=800

# Paid Claude API configuration (leave commented until you add Console credits).
# Use a separate, cheaper critic model. Rates below reflect the Claude pricing
# page on 2026-08-20; confirm them before enabling paid calls.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# LLM_MAX_OUTPUT_TOKENS=800
# LLM_INPUT_USD_PER_MTOK=2
# LLM_OUTPUT_USD_PER_MTOK=10
# LLM_MAX_REQUEST_USD=0.10
# QA_PROVIDER=anthropic
# QA_MODEL=claude-haiku-4-5-20251001
# QA_MAX_OUTPUT_TOKENS=200
# QA_INPUT_USD_PER_MTOK=1
# QA_OUTPUT_USD_PER_MTOK=5
# QA_MAX_REQUEST_USD=0.03
# LLM_PROJECT_BUDGET_USD=4.00
# LLM_USAGE_LEDGER=data/usage/llm_usage.jsonl
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# For CLI providers only: LLM_PROVIDER=claude_cli or gemini_cli
# LLM_CLI_COMMAND=claude -p --output-format json
